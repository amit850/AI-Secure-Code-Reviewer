{
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "version": "2.1.0",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "AI Secure Code Reviewer",
                    "version": "2.5",
                    "rules": [
                        {
                            "id": "CWE-434",
                            "name": "Insecure File Upload",
                            "shortDescription": {
                                "text": "Insecure File Upload"
                            },
                            "help": {
                                "text": "Possible insecure file upload detected."
                            },
                            "properties": {
                                "owasp": "A05:2021",
                                "confidence": "Medium"
                            }
                        }
                    ]
                }
            },
            "results": [
                {
                    "ruleId": "CWE-434",
                    "ruleIndex": 0,
                    "level": "error",
                    "message": {
                        "text": "Possible insecure file upload detected."
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "file_upload.py"
                                },
                                "region": {
                                    "startLine": 3
                                }
                            }
                        }
                    ]
                },
                {
                    "ruleId": "CWE-434",
                    "ruleIndex": 0,
                    "level": "error",
                    "message": {
                        "text": "Possible insecure file upload detected."
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "file_upload.py"
                                },
                                "region": {
                                    "startLine": 5
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}