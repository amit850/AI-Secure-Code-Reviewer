{
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "version": "2.1.0",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "AI Secure Code Reviewer",
                    "version": "2.5",
                    "rules": [
                        {
                            "id": "CWE-798",
                            "name": "Hardcoded Secrets",
                            "shortDescription": {
                                "text": "Hardcoded Secrets"
                            },
                            "help": {
                                "text": "Hardcoded secret detected."
                            },
                            "properties": {
                                "owasp": "A02:2021",
                                "confidence": "High"
                            }
                        },
                        {
                            "id": "CWE-798: Use of Hard-coded Credentials",
                            "name": "Hardcoded Secret",
                            "shortDescription": {
                                "text": "Hardcoded Secret"
                            },
                            "help": {
                                "text": "The API_KEY is hardcoded in the source code, which can lead to security vulnerabilities if the code is exposed or shared."
                            },
                            "properties": {
                                "owasp": "OWASP A07:2025 - Authentication Failures",
                                "confidence": "Certain"
                            }
                        },
                        {
                            "id": "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')",
                            "name": "SQL Injection",
                            "shortDescription": {
                                "text": "SQL Injection"
                            },
                            "help": {
                                "text": "The user input is directly concatenated into the SQL query, which allows for SQL injection attacks."
                            },
                            "properties": {
                                "owasp": "OWASP A05:2025 - Injection",
                                "confidence": "Certain"
                            }
                        },
                        {
                            "id": "CWE-79",
                            "name": "Cross-Site Scripting (XSS)",
                            "shortDescription": {
                                "text": "Cross-Site Scripting (XSS)"
                            },
                            "help": {
                                "text": "The application is vulnerable to Cross-Site Scripting (XSS) because it directly includes user input (`name`) in the HTML response without proper sanitization or escaping."
                            },
                            "properties": {
                                "owasp": "OWASP A05:2025 - Injection",
                                "confidence": "Certain"
                            }
                        }
                    ]
                }
            },
            "results": [
                {
                    "ruleId": "CWE-798",
                    "ruleIndex": 0,
                    "level": "error",
                    "message": {
                        "text": "Hardcoded secret detected."
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "hardcoded_secrets.py"
                                },
                                "region": {
                                    "startLine": 1
                                }
                            }
                        }
                    ]
                },
                {
                    "ruleId": "CWE-798",
                    "ruleIndex": 0,
                    "level": "error",
                    "message": {
                        "text": "Hardcoded secret detected."
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "hardcoded_secrets.py"
                                },
                                "region": {
                                    "startLine": 3
                                }
                            }
                        }
                    ]
                },
                {
                    "ruleId": "CWE-798: Use of Hard-coded Credentials",
                    "ruleIndex": 1,
                    "level": "warning",
                    "message": {
                        "text": "The API_KEY is hardcoded in the source code, which can lead to security vulnerabilities if the code is exposed or shared."
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "hardcoded_secrets.py"
                                },
                                "region": {
                                    "startLine": 1
                                }
                            }
                        }
                    ]
                },
                {
                    "ruleId": "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')",
                    "ruleIndex": 2,
                    "level": "error",
                    "message": {
                        "text": "The user input is directly concatenated into the SQL query, which allows for SQL injection attacks."
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "sqli.py"
                                },
                                "region": {
                                    "startLine": 5
                                }
                            }
                        }
                    ]
                },
                {
                    "ruleId": "CWE-79",
                    "ruleIndex": 3,
                    "level": "error",
                    "message": {
                        "text": "The application is vulnerable to Cross-Site Scripting (XSS) because it directly includes user input (`name`) in the HTML response without proper sanitization or escaping."
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uri": "xss.py"
                                },
                                "region": {
                                    "startLine": 8
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}